  command = cmd /c "bcc32 -S -c ${i686-windows-borland-omf_cflags} -IC:/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/src/include $in && move /Y ${source_stem}.asm ${outasm}"
rule i686-windows-borland-omf_link
  command = bcc32 ${i686-windows-borland-omf_cflags} -e$out $in
rule i686-windows-borland-omf_tdump
  command = tdump $in > $out

build ${i686-windows-borland-omf_outdir}\main.obj: i686-windows-borland-omf_cc src/main.c || ${i686-windows-borland-omf_outdir}\.dir.stamp
