i686-windows-borland-omf_cflags = -v -Od -M  
i686-windows-borland-omf_ldflags =   
build ${i686-windows-borland-omf_outdir}\.dir.stamp: ensure_dir
  dir = ${i686-windows-borland-omf_outdir}

rule i686-windows-borland-omf_cc
  command = cmd /c "bcc32 -c ${i686-windows-borland-omf_cflags} -IC:/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/src/include $in && move /Y ${source_stem}.obj ${outobj}"
