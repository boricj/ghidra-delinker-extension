build ${x86_64-linux-nolibc-gnu_outdir}/digits.s: x86_64-linux-nolibc-gnu_cc_asm src/digits.c || ${x86_64-linux-nolibc-gnu_outdir}/.dir.stamp
build ${x86_64-linux-nolibc-gnu_outdir}/digits.txt: x86_64-linux-nolibc-gnu_objdump ${x86_64-linux-nolibc-gnu_outdir}/digits.o || ${x86_64-linux-nolibc-gnu_outdir}/.dir.stamp
build ${x86_64-linux-nolibc-gnu_outdir}/integer-parsing.o: x86_64-linux-nolibc-gnu_combine ${x86_64-linux-nolibc-gnu_outdir}/main.o ${x86_64-linux-nolibc-gnu_outdir}/digits.o || ${x86_64-linux-nolibc-gnu_outdir}/.dir.stamp
build ${x86_64-linux-nolibc-gnu_outdir}/integer-parsing.elf: x86_64-linux-nolibc-gnu_link ${x86_64-linux-nolibc-gnu_outdir}/integer-parsing.o || ${x86_64-linux-nolibc-gnu_outdir}/.dir.stamp
build x86_64-linux-nolibc-gnu: phony ${x86_64-linux-nolibc-gnu_outdir}/integer-parsing.elf ${x86_64-linux-nolibc-gnu_outdir}/main.s ${x86_64-linux-nolibc-gnu_outdir}/digits.s ${x86_64-linux-nolibc-gnu_outdir}/main.txt ${x86_64-linux-nolibc-gnu_outdir}/digits.txt

