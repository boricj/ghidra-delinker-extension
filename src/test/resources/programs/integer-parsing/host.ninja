ninja_required_version = 1.7

rule ensure_dir
  command = C:\Users\jblbe\AppData\Local\Programs\Python\Python312\python.exe -c "import os,sys; os.makedirs(sys.argv[1], exist_ok=True); open(sys.argv[2], 'a').close()" "$dir" "$out"

# i686-windows-msvc-coff
i686-windows-msvc-coff_outdir = C:\Users\jblbe\Documents\Workspace\ghidra-delinker-extension\src\test\resources\programs\integer-parsing\reference\coff\windows-msvc\x86
i686-windows-msvc-coff_cflags = /TC /Zi /Od /nologo  
i686-windows-msvc-coff_ldflags = /nologo  
build ${i686-windows-msvc-coff_outdir}\.dir.stamp: ensure_dir
  dir = ${i686-windows-msvc-coff_outdir}

rule i686-windows-msvc-coff_cc
  command = "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x86\cl.exe" ${i686-windows-msvc-coff_cflags} /IC:/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/src/include /FS /Fd${outdir}\${obj_name}.pdb /c $in /Fo${outdir}\${obj_name}.obj /Fa${outdir}\${obj_name}.asm
rule i686-windows-msvc-coff_dumpbin
  command = cmd /c ""C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64\dumpbin.exe" /nologo /all $in > $out"
rule i686-windows-msvc-coff_link
  command = "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64\link.exe" /nologo /MACHINE:X86 /OUT:${exe} /DEBUG /PDB:${pdb} /LIBPATH:"C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0\um\x86" /LIBPATH:"C:\Program Files (x86)\Windows Kits\10\Lib\10.0.26100.0\ucrt\x86" ${i686-windows-msvc-coff_ldflags} $in

build ${i686-windows-msvc-coff_outdir}\main.obj ${i686-windows-msvc-coff_outdir}\main.asm: i686-windows-msvc-coff_cc src/main.c || ${i686-windows-msvc-coff_outdir}\.dir.stamp
  obj_name = main
  outdir = ${i686-windows-msvc-coff_outdir}
build ${i686-windows-msvc-coff_outdir}\main.txt: i686-windows-msvc-coff_dumpbin ${i686-windows-msvc-coff_outdir}\main.obj || ${i686-windows-msvc-coff_outdir}\.dir.stamp
build ${i686-windows-msvc-coff_outdir}\digits.obj ${i686-windows-msvc-coff_outdir}\digits.asm: i686-windows-msvc-coff_cc src/digits.c || ${i686-windows-msvc-coff_outdir}\.dir.stamp
  obj_name = digits
  outdir = ${i686-windows-msvc-coff_outdir}
build ${i686-windows-msvc-coff_outdir}\digits.txt: i686-windows-msvc-coff_dumpbin ${i686-windows-msvc-coff_outdir}\digits.obj || ${i686-windows-msvc-coff_outdir}\.dir.stamp
build ${i686-windows-msvc-coff_outdir}\integer-parsing.exe ${i686-windows-msvc-coff_outdir}\integer-parsing.pdb: i686-windows-msvc-coff_link ${i686-windows-msvc-coff_outdir}\main.obj ${i686-windows-msvc-coff_outdir}\digits.obj || ${i686-windows-msvc-coff_outdir}\.dir.stamp
  exe = ${i686-windows-msvc-coff_outdir}\integer-parsing.exe
  pdb = ${i686-windows-msvc-coff_outdir}\integer-parsing.pdb
build ${i686-windows-msvc-coff_outdir}\integer-parsing.exe.txt: i686-windows-msvc-coff_dumpbin ${i686-windows-msvc-coff_outdir}\integer-parsing.exe || ${i686-windows-msvc-coff_outdir}\.dir.stamp
build i686-windows-msvc-coff: phony ${i686-windows-msvc-coff_outdir}\integer-parsing.exe ${i686-windows-msvc-coff_outdir}\integer-parsing.pdb ${i686-windows-msvc-coff_outdir}\integer-parsing.exe.txt ${i686-windows-msvc-coff_outdir}\main.asm ${i686-windows-msvc-coff_outdir}\digits.asm ${i686-windows-msvc-coff_outdir}\main.txt ${i686-windows-msvc-coff_outdir}\digits.txt

