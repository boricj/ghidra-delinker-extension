ninja_required_version = 1.7

rule ensure_dir
  command = /usr/bin/python3 -c "import os,sys; os.makedirs(sys.argv[1], exist_ok=True); open(sys.argv[2], 'a').close()" "$dir" "$out"

# i686-linux-nolibc-gnu
i686-linux-nolibc-gnu_outdir = /mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/reference/elf/linux-nolibc/i686
i686-linux-nolibc-gnu_cflags = -gdwarf-4 -gctf -ffreestanding -fno-builtin -nostdinc -fno-pie -fno-pic -fno-asynchronous-unwind-tables -fno-unwind-tables  
i686-linux-nolibc-gnu_ldflags = -nostdlib -static -no-pie -Wl,--build-id=none -lgcc  
build ${i686-linux-nolibc-gnu_outdir}/.dir.stamp: ensure_dir
  dir = ${i686-linux-nolibc-gnu_outdir}

rule i686-linux-nolibc-gnu_cc_obj
  command = i686-linux-gnu-gcc ${i686-linux-nolibc-gnu_cflags} -I/mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/src/include -I/home/boricj/Documents/linux/tools/include -I/home/boricj/Documents/linux/tools/include/nolibc -isystem /usr/include/$$(i686-linux-gnu-gcc -dumpmachine) -isystem /usr/$$(i686-linux-gnu-gcc -dumpmachine)/include -isystem $$(i686-linux-gnu-gcc -print-sysroot)/usr/include -isystem $$(i686-linux-gnu-gcc -print-file-name=include) -c $in -o $out
rule i686-linux-nolibc-gnu_cc_asm
  command = i686-linux-gnu-gcc ${i686-linux-nolibc-gnu_cflags} -I/mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/integer-parsing/src/include -I/home/boricj/Documents/linux/tools/include -I/home/boricj/Documents/linux/tools/include/nolibc -isystem /usr/include/$$(i686-linux-gnu-gcc -dumpmachine) -isystem /usr/$$(i686-linux-gnu-gcc -dumpmachine)/include -isystem $$(i686-linux-gnu-gcc -print-sysroot)/usr/include -isystem $$(i686-linux-gnu-gcc -print-file-name=include) -S -c $in -o $out
rule i686-linux-nolibc-gnu_objdump
  command = i686-linux-gnu-objdump -x $in > $out
rule i686-linux-nolibc-gnu_combine
  command = i686-linux-gnu-gcc -r $in -o $out
rule i686-linux-nolibc-gnu_link
  command = i686-linux-gnu-gcc $in -o $out ${i686-linux-nolibc-gnu_ldflags}

build ${i686-linux-nolibc-gnu_outdir}/main.o: i686-linux-nolibc-gnu_cc_obj src/main.c || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/main.s: i686-linux-nolibc-gnu_cc_asm src/main.c || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/main.txt: i686-linux-nolibc-gnu_objdump ${i686-linux-nolibc-gnu_outdir}/main.o || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/digits.o: i686-linux-nolibc-gnu_cc_obj src/digits.c || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/digits.s: i686-linux-nolibc-gnu_cc_asm src/digits.c || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/digits.txt: i686-linux-nolibc-gnu_objdump ${i686-linux-nolibc-gnu_outdir}/digits.o || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/integer-parsing.o: i686-linux-nolibc-gnu_combine ${i686-linux-nolibc-gnu_outdir}/main.o ${i686-linux-nolibc-gnu_outdir}/digits.o || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build ${i686-linux-nolibc-gnu_outdir}/integer-parsing.elf: i686-linux-nolibc-gnu_link ${i686-linux-nolibc-gnu_outdir}/integer-parsing.o || ${i686-linux-nolibc-gnu_outdir}/.dir.stamp
build i686-linux-nolibc-gnu: phony ${i686-linux-nolibc-gnu_outdir}/integer-parsing.elf ${i686-linux-nolibc-gnu_outdir}/main.s ${i686-linux-nolibc-gnu_outdir}/digits.s ${i686-linux-nolibc-gnu_outdir}/main.txt ${i686-linux-nolibc-gnu_outdir}/digits.txt

