ninja_required_version = 1.7

rule ensure_dir
  command = /usr/bin/python3 -c "import os,sys; os.makedirs(sys.argv[1], exist_ok=True); open(sys.argv[2], 'a').close()" "$dir" "$out"

# aarch64-linux-gnu-gnu
aarch64-linux-gnu-gnu_outdir = /mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/ascii-table/reference/elf/linux-gnu/aarch64
aarch64-linux-gnu-gnu_cflags = -gdwarf-4 -gctf  
aarch64-linux-gnu-gnu_ldflags = -Wl,--build-id=none  
build ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp: ensure_dir
  dir = ${aarch64-linux-gnu-gnu_outdir}

rule aarch64-linux-gnu-gnu_cc_obj
  command = aarch64-linux-gnu-gcc ${aarch64-linux-gnu-gnu_cflags} -I/mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/ascii-table/include -c $in -o $out
rule aarch64-linux-gnu-gnu_cc_asm
  command = aarch64-linux-gnu-gcc ${aarch64-linux-gnu-gnu_cflags} -I/mnt/c/Users/jblbe/Documents/Workspace/ghidra-delinker-extension/src/test/resources/programs/ascii-table/include -S -c $in -o $out
rule aarch64-linux-gnu-gnu_objdump
  command = aarch64-linux-gnu-objdump -x $in > $out
rule aarch64-linux-gnu-gnu_combine
  command = aarch64-linux-gnu-gcc -r $in -o $out
rule aarch64-linux-gnu-gnu_link
  command = aarch64-linux-gnu-gcc $in -o $out ${aarch64-linux-gnu-gnu_ldflags}

build ${aarch64-linux-gnu-gnu_outdir}/main.o: aarch64-linux-gnu-gnu_cc_obj src/main.c || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/main.s: aarch64-linux-gnu-gnu_cc_asm src/main.c || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/main.txt: aarch64-linux-gnu-gnu_objdump ${aarch64-linux-gnu-gnu_outdir}/main.o || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.o: aarch64-linux-gnu-gnu_cc_obj src/openbsd_ctype.c || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.s: aarch64-linux-gnu-gnu_cc_asm src/openbsd_ctype.c || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.txt: aarch64-linux-gnu-gnu_objdump ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.o || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/ascii-table.o: aarch64-linux-gnu-gnu_combine ${aarch64-linux-gnu-gnu_outdir}/main.o ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.o || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build ${aarch64-linux-gnu-gnu_outdir}/ascii-table.elf: aarch64-linux-gnu-gnu_link ${aarch64-linux-gnu-gnu_outdir}/ascii-table.o || ${aarch64-linux-gnu-gnu_outdir}/.dir.stamp
build aarch64-linux-gnu-gnu: phony ${aarch64-linux-gnu-gnu_outdir}/ascii-table.elf ${aarch64-linux-gnu-gnu_outdir}/main.s ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.s ${aarch64-linux-gnu-gnu_outdir}/main.txt ${aarch64-linux-gnu-gnu_outdir}/openbsd_ctype.txt

